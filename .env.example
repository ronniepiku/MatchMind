# Database connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=MatchMind
POSTGRES_USER=analyst
POSTGRES_PASSWORD=   # REQUIRED — set a strong password before running
POSTGRES_VERSION=16.6

# Optional: StatsBomb API credentials (not needed for open data)
# STATSBOMB_USERNAME=
# STATSBOMB_PASSWORD=

# API server
API_HOST=127.0.0.1
API_PORT=8080

# CORS — comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Cache settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=500

# Data quality
DATA_QUALITY_STRICT=false
DATA_QUALITY_LOG_LEVEL=warning

# Ingestion
INGEST_CONCURRENCY=8
INGEST_BATCH_SIZE=50

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Railway deployment (auto-set by Railway)
# DATABASE_URL=postgresql://...
# PORT=8080
# RAILWAY_ENVIRONMENT=production
