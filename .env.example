# Database connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=MatchMind
POSTGRES_USER=analyst
POSTGRES_PASSWORD=   # REQUIRED — set a strong password before running
POSTGRES_VERSION=16.6

# Optional: StatsBomb API credentials (not needed for open data)
# STATSBOMB_USERNAME=
# STATSBOMB_PASSWORD=

# API server
API_HOST=127.0.0.1
API_PORT=8080

# CORS — comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173
